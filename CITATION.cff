    given-names: Sujon
    orcid: "https://orcid.org/0009-0001-1032-2818"
    affiliation: "StatAid Research Lab, Dhaka, Bangladesh"
repository-code: "https://github.com/StatAid-Research-Lab/SurveyNCD"
url: "https://CRAN.R-project.org/package=SurveyNCD"
identifiers:
  - type: doi
    value: "10.32614/CRAN.package.SurveyNCD"
keywords:
  - R
  - survey statistics
  - multimorbidity
  - non-communicable diseases
  - health inequality
